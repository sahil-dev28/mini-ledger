generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  createdAt DateTime @default(now())
  loans     Loan[]
}

// one active OTP per phone, a new request overwrites the old one
model Otp {
  phone     String   @id
  codeHash  String
  expiresAt DateTime
}

model Loan {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendName  String
  amount      Decimal   @db.Decimal(12, 2)
  dueDate     DateTime  @db.Date
  repaidAt    DateTime?
  receiptPath String?
  createdAt   DateTime  @default(now())

  @@index([userId])
}
